{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Radar",
  "colors": {
    "primary": "#0005FB",
    "light": "#A6BAED",
    "dark": "#0003A5"
  },
  "fonts": {
    "heading": {
      "family": "Graphik",
      "source": "/fonts/Graphik-500-Medium.woff2",
      "weight": 500,
      "format": "woff2"
    },
    "body": {
      "family": "Graphik",
      "source": "/fonts/Graphik-400-Regular.woff2",
      "weight": 400,
      "format": "woff2"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light-default",
        "dark": "github-dark-default"
      }
    }
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#131415"
    }
  },
  "logo": {
    "light": "/images/logo/radar-light.svg",
    "dark": "/images/logo/radar-dark.svg"
  },
  "favicon": {
    "light": "/images/radar-dark.png",
    "dark": "/images/radar-light.png"
  },
  "redirects": [
    {
      "source": "/home",
      "destination": "/"
    },
    {
      "source": "/sdk/fraud",
      "destination": "/geofencing/fraud"
    },
    {
      "source": "/trip-tracking",
      "destination": "/geofencing/trips"
    },
    {
      "source": "/places",
      "destination": "/geofencing/places"
    },
    {
      "source": "/geofences",
      "destination": "/geofencing/geofences"
    },
    {
      "source": "/beacons",
      "destination": "/geofencing/beacons"
    },
    {
      "source": "/regions",
      "destination": "/geofencing/regions"
    },
    {
      "source": "/fraud",
      "destination": "/geofencing/fraud"
    },
    {
      "source": "/campaigns",
      "destination": "/geofencing/campaigns"
    },
    {
      "source": "/sdk",
      "destination": "/sdk/sdk"
    },
    {
      "source": "/sdk/xamarin",
      "destination": "/sdk/maui"
    },
    {
      "source": "/tutorials/integrations/braze",
      "destination": "/integrations/braze"
    },
    {
      "source": "/tutorials/building-a-delivery-tracker-with-live-location-and-etas",
      "destination": "/tutorials/building-a-delivery-tracking-app"
    }
  ],
  "navigation": {
